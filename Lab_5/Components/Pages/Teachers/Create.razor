@page "/teachers/create"
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Lab_5.Data
@using Lab_5.Models
@inject UniversityDbContext Context
@inject NavigationManager Navigation

<PageTitle>Додати викладача</PageTitle>

<h2 class="my-4 fw-bold text-secondary">Додавання нового викладача</h2>

<div class="row">
    <div class="col-md-6 bg-white p-4 rounded shadow-sm mb-5">
        <EditForm Model="teacherModel" OnValidSubmit="HandleValidSubmit" FormName="createForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Прізвище</label>
                <InputText @bind-Value="teacherModel.LastName" class="form-control" />
                <ValidationMessage For="@(() => teacherModel.LastName)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Ім'я</label>
                <InputText @bind-Value="teacherModel.FirstName" class="form-control" />
                <ValidationMessage For="@(() => teacherModel.FirstName)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">По батькові</label>
                <InputText @bind-Value="teacherModel.MiddleName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Телефон</label>
                <InputText @bind-Value="teacherModel.Phone" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Місце роботи</label>
                <InputText @bind-Value="teacherModel.Workplace" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Посада</label>
                <InputSelect @bind-Value="teacherModel.PositionID" class="form-select">
                    <option value="0">-- Оберіть посаду --</option>
                    @if (positions != null)
                    {
                        @foreach (var pos in positions)
                        {
                            <option value="@pos.PositionID">@pos.PositionName</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="@(() => teacherModel.PositionID)" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Домашня адреса</label>
                <InputText @bind-Value="teacherModel.HomeAddress" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Характеристика</label>
                <InputTextArea @bind-Value="teacherModel.Characteristic" class="form-control" rows="3" />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary fw-semibold me-2">Зберегти</button>
                <a href="/teachers" class="btn btn-secondary">Скасувати</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private TeacherCreateModel teacherModel { get; set; } = new();

    private List<Position>? positions;

    protected override async Task OnInitializedAsync()
    {
        positions = await Context.Positions.ToListAsync();
    }

    private async Task HandleValidSubmit()
    {
        var teacher = new Teacher
        {
            LastName = teacherModel.LastName,
            FirstName = teacherModel.FirstName,
            MiddleName = teacherModel.MiddleName,
            Phone = teacherModel.Phone,
            Workplace = teacherModel.Workplace,
            PositionID = teacherModel.PositionID,
            HomeAddress = teacherModel.HomeAddress,
            Characteristic = teacherModel.Characteristic
        };

        Context.Teachers.Add(teacher);
        await Context.SaveChangesAsync();
        Navigation.NavigateTo("/teachers");
    }

    public class TeacherCreateModel
    {
        [Required(ErrorMessage = "Прізвище є обов'язковим")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ім'я є обов'язковим")]
        public string FirstName { get; set; } = string.Empty;

        public string? MiddleName { get; set; }
        public string? Phone { get; set; }
        public string? Workplace { get; set; }

        [Required(ErrorMessage = "Оберіть посаду")]
        [Range(1, int.MaxValue, ErrorMessage = "Оберіть посаду")]
        public int PositionID { get; set; }

        public string? HomeAddress { get; set; }
        public string? Characteristic { get; set; }
    }
}