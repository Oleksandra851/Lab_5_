@page "/teachers/details/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using Lab_5.Data
@using Lab_5.Models
@inject UniversityDbContext Context

<PageTitle>Деталі викладача</PageTitle>

<h2 class="my-4 fw-bold text-secondary">Детальна інформація про викладача</h2>

@if (teacher == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="bg-white p-4 rounded shadow-sm">
        <dl class="row fs-5">
            <dt class="col-sm-3">ПІБ Викладача</dt>
            <dd class="col-sm-9 fw-semibold">@($"{teacher.LastName} {teacher.FirstName} {teacher.MiddleName}")</dd>
            <dt class="col-sm-3">Телефон</dt>
            <dd class="col-sm-9">@teacher.Phone</dd>
            <dt class="col-sm-3">Місце роботи</dt>
            <dd class="col-sm-9">@teacher.Workplace</dd>
            <dt class="col-sm-3">Посада</dt>
            <dd class="col-sm-9">@teacher.Position?.PositionName</dd>
            <dt class="col-sm-3">Домашня адреса</dt>
            <dd class="col-sm-9">@teacher.HomeAddress</dd>
            <dt class="col-sm-3">Характеристика</dt>
            <dd class="col-sm-9">@teacher.Characteristic</dd>
        </dl>
        <div class="mt-4">
            <a href="/teachers/edit/@teacher.TeacherID" class="btn btn-warning fw-semibold">Редагувати</a>
            <a href="/teachers" class="btn btn-secondary">Назад до списку</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Teacher? teacher;

    protected override async Task OnInitializedAsync()
    {
        teacher = await Context.Teachers
            .Include(t => t.Position)
            .Include(t => t.TeacherSubjects)
                .ThenInclude(ts => ts.Subject)
            .FirstOrDefaultAsync(t => t.TeacherID == Id);
    }
}